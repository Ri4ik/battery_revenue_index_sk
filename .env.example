# Copy to .env and change before deploying publicly.
POSTGRES_USER=bri
POSTGRES_PASSWORD=change-me
POSTGRES_DB=battery_revenue_index

# ENTSO-E Transparency Platform token (aFRR capacity download in the worker).
ENTSOE_API_KEY=

# OneDrive Personal folder of the project owner (rclone remote "onedrive", see deploy/CRON.md).
# Empty = the OneDrive step is skipped.
ONEDRIVE_REMOTE=onedrive:BatteryIndex

# Local SEPS XLSX intake (set BRI_FILE_SOURCE=local to use it in the daily worker).
BRI_FILE_SOURCE=local
BRI_INBOX_HOST=./incoming
BRI_REPORTS_HOST=./reports/local_inbox
BRI_LOCAL_MIN_AGE_SECONDS=10
# Enable only when imported input files may be deleted after verified publication.
BRI_DELETE_AFTER_SUCCESS=0
